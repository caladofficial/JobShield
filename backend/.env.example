# JobShield Backend Environment Variables
# Copy this to .env and fill in your values

# Application
APP_NAME=JobShield
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobshield

# Redis (for Celery queues and caching)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Demo Mode (uses synthetic data)
DEMO_MODE=true
DEMO_JOBS_COUNT=50

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Export Storage
EXPORT_STORAGE_PATH=/tmp/exports
EXPORT_URL_EXPIRE_HOURS=24

# Email Providers (optional - for outreach)
# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Microsoft Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=

# SMTP (fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# AI (optional - for AI analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Job Board APIs (require approval)
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Supabase (for auth/storage if used)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=