# JobShield Environment Configuration
# Copy this to .env and fill in your values

# Application
APP_NAME="JobShield"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/jobshield"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=20

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600

# Frontend
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Email Providers
# Gmail API
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/api/auth/callback/gmail"

# Microsoft Graph
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/callback/microsoft"

# SMTP (fallback)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="JobShield"

# AI Providers (optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# External APIs
INDEED_CLIENT_ID=""
INDEED_CLIENT_SECRET=""
INDEED_PUBLISHER_ID=""

LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Source API Keys (for ATS integrations)
GREENHOUSE_API_KEY=""
LEVER_API_KEY=""
WORKABLE_API_KEY=""
ASHBY_API_KEY=""
SMARTRECRUITERS_API_KEY=""
WORKDAY_CLIENT_ID=""
WORKDAY_CLIENT_SECRET=""

# DNS/WHOIS/RDAP
RDAP_BOOTSTRAP_URL="https://data.iana.org/rdap/dns.json"

# URL Reputation
URLSCAN_API_KEY=""
VIRUSTOTAL_API_KEY=""

# Company Enrichment
CLEARBIT_API_KEY=""
APOLLO_API_KEY=""

# File Storage (for exports)
STORAGE_TYPE="local"  # local, s3, gcs
LOCAL_STORAGE_PATH="./storage/exports"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Monitoring
SENTRY_DSN=""
LOG_LEVEL="INFO"

# Demo Mode
DEMO_MODE=false
DEMO_DATA_COUNT=50

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Security
BCRYPT_ROUNDS=12
JWT_ALGORITHM="HS256"
CSRF_SECRET="your-csrf-secret-change-in-production"

# Encryption
ENCRYPTION_KEY="your-32-char-encryption-key-here!!"